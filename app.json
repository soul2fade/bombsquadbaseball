{
  "expo": {
    "name": "Slugger",
    "slug": "slugger",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "slugger",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.slugger.app"
    },
    "android": {
      "package": "com.slugger.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
